{
  "name": "agent-board",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pierre/diffs": "^1.6.1",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.89.0",
    "shiki": "4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "lint": "oxlint server web/src",
    "service:install": "node scripts/service.ts install",
    "service:uninstall": "node scripts/service.ts uninstall",
    "service:restart": "node scripts/service.ts restart",
    "open": "open -na 'Brave Browser' --args --app=http://127.0.0.1:7420",
    "check": "tsc && oxlint server web/src scripts",
    "claude:connect": "node scripts/claude.ts connect",
    "claude:disconnect": "node scripts/claude.ts disconnect"
  }
}
